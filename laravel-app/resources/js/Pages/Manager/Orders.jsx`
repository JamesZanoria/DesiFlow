import React, { useState } from 'react';
import { Head, router, usePage } from '@inertiajs/react';

const STATUS_COLORS = {
    pending: 'bg-amber-100 text-amber-800 border-amber-200',
    ready: 'bg-green-100 text-green-800 border-green-200',
    picked_up: 'bg-slate-100 text-slate-700 border-slate-200',
    dropped: 'bg-slate-100 text-slate-700 border-slate-200',
};

const OrderRow = ({ order }) => {
    if (!order) return null;
    const [isUpdating, setIsUpdating] = useState(false);

    const updateStatus = (newStatus) => {
        if (!confirm(`Mark Order #${order.order_number} as ${newStatus}?`)) return;

        setIsUpdating(true);
        router.patch(route('manager.orders.status', order.id), {
            status: newStatus
        }, {
            onSuccess: () => setIsUpdating(false),
            onError: () => {
                alert('Failed to update status');
                setIsUpdating(false);
            }
        });
    };

    return (
        <tr className="border-b border-slate-100 hover:bg-slate-50 transition-colors">
            <td className="px-4 py-4 align-top">
                <p className="font-semibold text-slate-900">#{order.order_number || order.id}</p>
                <p className="mt-1 text-xs text-slate-500">
                    {order.order_type === 'takeout' ? 'Takeout' : (order.table_number ? `Table ${order.table_number}` : 'Dine-in')}
                    {' · ' + (order.created_at ? new Date(order.created_at).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }) : 'N/A')}
                </p>
            </td>
            <td className="px-4 py-4 align-top text-sm text-slate-600">
                {order.order_items?.map((item, idx) => (
                    <div key={idx} className="flex justify-between gap-4">
                        <span>{item.quantity} × {item.menu_item?.item_name || 'Item'}</span>
                    </div>
                ))}
            </td>
            <td className="px-4 py-4 align-top font-medium text-slate-900">
                ₱{parseFloat(order.total_amount || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
            </td>
            <td className="px-4 py-4 align-top">
                <span className={`rounded-full px-2.5 py-1 text-xs font-semibold border ${STATUS_COLORS[order.status] || 'bg-gray-100 text-gray-700 border-gray-200'}`}>
                    {order.status?.replace('_', ' ').toUpperCase() || 'UNKNOWN'}
                </span>
            </td>
            <td className="px-4 py-4 align-top text-right">
                <div className="flex justify-end gap-2">
                    {order.status === 'pending' && (
                        <button
                            onClick={() => updateStatus('ready')}
                            disabled={isUpdating}
                            className="rounded-lg bg-green-600 px-3 py-2 text-xs font-semibold text-white hover:bg-green-700 transition-colors disabled:opacity-50"
                        >
                            Mark ready
                        </button>
                    )}
                    {order.status === 'ready' && (
                        <div className="flex gap-2">
                            <button
                                onClick={() => updateStatus('picked_up')}
                                disabled={isUpdating}
                                className="rounded-lg border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50 transition-colors disabled:opacity-50"
                            >
                                Picked up
                            </button>
                            <button
                                onClick={() => updateStatus('dropped')}
                                disabled={isUpdating}
                                className="rounded-lg border border-gray-300 px-3 py-2 text-xs font-semibold text-gray-700 hover:bg-gray-50 transition-colors disabled:opacity-50"
                            >
                                Complete
                            </button>
                        </div>
                    )}
                    {order.status !== 'pending' && order.status !== 'ready' && (
                        <span className="text-xs text-gray-400">No action required</span>
                    )}
                </div>
            </td>
        </tr>
    );
};

export default function Orders({ orders = [] }) {
    const { props } = usePage();
    const flash = props?.flash;

    return (
        <div className="h-screen overflow-hidden flex flex-col p-6 bg-slate-50/50">
            <nav className="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-slate-400 mb-6">
                <a href="/admin/dashboard" className="hover:text-amber-600 transition-colors flex items-center gap-1">
                    <svg className="w-3 h-3" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" d="M15 19l-7-7 7-7" /></svg>
                    Admin Dashboard
                </a>
                <span className="text-slate-300">
                    <svg className="w-3 h-3 inline-block" fill="none" stroke="currentColor" strokeWidth="2.5" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" d="M9 5l7 7-7 7" /></svg>
                </span>
                <span className="text-slate-900">Order Workflow</span>
            </nav>

            <div className="flex-1 min-h-0 overflow-hidden flex flex-col">
                <div className="mb-6">
                    <h1 className="text-2xl font-bold text-slate-900">Order workflow</h1>
                    <p className="mt-1 text-sm text-slate-500">Move ready orders through pickup or completion. Kitchen preparation stays in the separate KDS.</p>
                </div>

                {flash?.status && (
                    <div className="mb-4 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 animate-in fade-in slide-in-from-top-2">
                        {flash.status}
                    </div>
                )}

                <div className="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex-1 flex flex-col min-h-0">
                    <div className="overflow-x-auto flex-1">
                        <table className="w-full min-w-[760px] text-left text-sm">
                            <thead className="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 border-b border-slate-200">
                                <tr className="whitespace-nowrap">
                                    <th className="px-4 py-3">Order</th>
                                    <th className="px-4 py-3">Items</th>
                                    <th className="px-4 py-3">Total</th>
                                    <th className="px-4 py-3">Status</th>
                                    <th className="px-4 py-3 text-right">Update</th>
                                </tr>
                            </thead>
                            <tbody className="divide-y divide-slate-100">
                                {orders && orders.length > 0 ? (
                                    orders.map(order => <OrderRow key={order?.id} order={order} />)
                                ) : (
                                    <tr>
                                        <td colSpan="5" className="px-4 py-12 text-center text-sm text-slate-400 italic">
                                        No orders are available in the manager workflow.
                                        </td>
                                    </tr>
                                )}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    );
}
