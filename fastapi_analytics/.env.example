# --- Database ---
# Per SRS §2.4/§2.5: FastAPI reads the shared PostgreSQL 16 DB. Capstone 1 Ch.3
# specifies read-only credentials for the business tables, but this service
# also needs INSERT rights on analytics_snapshots specifically.
#
# Simplest setup for now (dev): one Postgres role with SELECT on everything +
# INSERT on analytics_snapshots only. Tighten later if your adviser wants two
# separate DB roles/connections.
DATABASE_URL=postgresql+asyncpg://desiflow_analytics:changeme@localhost:5432/desiflow

# --- Scheduler ---
# Business Health Score is meant to accumulate one row per day (see the
# contract docblock in AnalyticsController.php). Others get overwritten daily.
DAILY_RUN_HOUR=2
DAILY_RUN_MINUTE=0

# --- Windows used by the calculations (days) ---
SALES_LOOKBACK_DAYS=30
USAGE_LOOKBACK_DAYS=14
FORECAST_HORIZON_DAYS=7
MIN_DATA_POINTS_FOR_FORECAST=5
